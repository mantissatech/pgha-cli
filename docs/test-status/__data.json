{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,6,10,14,18,22,26,30,34,38,42,46,50,54,58,62,66,70,74,78,82,86,90,94,98],{"slug":3,"title":4,"num":5},"what-pgha-does","What pgha does",1,{"slug":7,"title":8,"num":9},"architecture","Architecture",2,{"slug":11,"title":12,"num":13},"requirements","Requirements",3,{"slug":15,"title":16,"num":17},"install","Install",4,{"slug":19,"title":20,"num":21},"quick-start","Quick start",5,{"slug":23,"title":24,"num":25},"command-reference","Command reference",6,{"slug":27,"title":28,"num":29},"environment-variables","Environment variables",7,{"slug":31,"title":32,"num":33},"the-state-file","The state file",8,{"slug":35,"title":36,"num":37},"cloud-resources","Cloud resources",9,{"slug":39,"title":40,"num":41},"what-runs-on-each-node","What runs on each node",10,{"slug":43,"title":44,"num":45},"the-monthly-bill","The monthly bill",11,{"slug":47,"title":48,"num":49},"project-databases","Project databases",12,{"slug":51,"title":52,"num":53},"pgbouncer-and-connection-limits","PgBouncer and connection limits",13,{"slug":55,"title":56,"num":57},"backups","Backups",14,{"slug":59,"title":60,"num":61},"tailscale","Tailscale",15,{"slug":63,"title":64,"num":65},"alerts","Alerts",16,{"slug":67,"title":68,"num":69},"move-from-an-existing-server","Move from an existing server",17,{"slug":71,"title":72,"num":73},"operations","Operations",18,{"slug":75,"title":76,"num":77},"troubleshooting","Troubleshooting",19,{"slug":79,"title":80,"num":81},"security","Security",20,{"slug":83,"title":84,"num":85},"limits","Limits",21,{"slug":87,"title":88,"num":89},"test-status","Test status",22,{"slug":91,"title":92,"num":93},"code-structure","Code structure",23,{"slug":95,"title":96,"num":97},"development","Development",24,{"slug":99,"title":100,"num":101},"references","References",null],"uses":{}},{"type":"data","data":[{"doc":1,"prev":8,"next":11},{"slug":2,"num":3,"title":4,"html":5,"toc":6,"summary":7},"test-status",22,"Test status","\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Area\u003C/th>\u003Cth>How it was tested\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>Build, \u003Ccode>go vet\u003C/code>, unit tests\u003C/td>\u003Ctd>Run on each change. All pass.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Price reading\u003C/td>\u003Ctd>Against a mock of the Hetzner pricing API.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Boot files\u003C/td>\u003Ctd>Rendered and checked: YAML parse, shell syntax.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>db create\u003C/code>, \u003Ccode>db drop\u003C/code>, isolation\u003C/td>\u003Ctd>Real local Postgres 16.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>db import\u003C/code>\u003C/td>\u003Ctd>Real local Postgres 16, end to end.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>adopt\u003C/code> check script\u003C/td>\u003Ctd>Real local Postgres 16 in the Debian layout.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>adopt\u003C/code> takeover, rollback, join, switchover\u003C/td>\u003Ctd>Local Postgres 16, Patroni 3.2, etcd 3.5. The \u003Ccode>systemctl\u003C/code> and \u003Ccode>apt-get\u003C/code> calls were replaced by stand-ins.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>PgBouncer files, login check, limits\u003C/td>\u003Ctd>Local Postgres 16 and PgBouncer 1.22.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>PgBouncer with \u003Ccode>pgx\u003C/code>\u003C/td>\u003Ctd>30 clients, 150 queries, pool of 3: no failed query.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Alert timer\u003C/td>\u003Ctd>Rendered files, shell syntax, and the script with stub \u003Ccode>patronictl\u003C/code>, \u003Ccode>df\u003C/code>, \u003Ccode>curl\u003C/code>, \u003Ccode>systemctl\u003C/code>, \u003Ccode>psql\u003C/code>, \u003Ccode>pgbackrest\u003C/code>, \u003Ccode>timeout\u003C/code>, and \u003Ccode>flock\u003C/code>. Install uses a fake SSH client.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>SQLite state file\u003C/td>\u003Ctd>Real SQLite file: secrets, task history, schema check, old file import, relative path, two writers at once, file mode. Cross-built for all release targets.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Web console\u003C/td>\u003Ctd>Fake cloud and SSH adapters: every page, a create job with live log, cross-site block. Task history across a restart with a real state file.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Console monitoring and explorer\u003C/td>\u003Ctd>Three Docker nodes (Ubuntu 24.04, Postgres 16, streaming replication) under pgbench load, over real SSH: metrics, replication, activity, table browse and filters, insert, edit, delete, SQL errors, read-only mode, replica reads, a table name with \u003Ccode>%\u003C/code>. Unit tests for SQL building and the shell-safe command.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Load balancer attach order, failure cleanup\u003C/td>\u003Ctd>Unit tests with a fake Hetzner API.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Tailscale device cleanup and auth key\u003C/td>\u003Ctd>Unit tests against a fake Tailscale API.\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>\u003Cstrong>Not tested:\u003C/strong> a run against the real Hetzner API, real cloud-init on a\nHetzner server, the load balancer, pgBackRest with a real bucket,\nTailscale, a real webhook, a real Patroni failover, and the Patroni status\nin the console.\u003C/p>\n\u003Cp>Do a trial run with a test project before production use:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> up\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --name\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> trial\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --volume-gb\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> 10\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> status\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --name\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> trial\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> db\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> create\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> demo\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --name\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> trial\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> down\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --name\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> trial\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --delete-volumes\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n",[],"Not tested: a run against the real Hetzner API, real cloud-init on a Hetzner server, the load balancer, pgBackRest with a real bucket, Tailscale, a real webh…",{"slug":9,"title":10},"limits","Limits",{"slug":12,"title":13},"code-structure","Code structure"],"uses":{"params":["slug"]}}]}
