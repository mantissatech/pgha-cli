{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,6,10,14,18,22,26,30,34,38,42,46,50,54,58,62,66,70,74,78,82,86,90,94,98,102,106],{"slug":3,"title":4,"num":5},"what-pgha-does","What pgha does",1,{"slug":7,"title":8,"num":9},"architecture","Architecture",2,{"slug":11,"title":12,"num":13},"requirements","Requirements",3,{"slug":15,"title":16,"num":17},"install","Install",4,{"slug":19,"title":20,"num":21},"container-image","Container image",5,{"slug":23,"title":24,"num":25},"run-the-console-on-a-server","Run the console on a server",6,{"slug":27,"title":28,"num":29},"quick-start","Quick start",7,{"slug":31,"title":32,"num":33},"command-reference","Command reference",8,{"slug":35,"title":36,"num":37},"environment-variables","Environment variables",9,{"slug":39,"title":40,"num":41},"the-state-file","The state file",10,{"slug":43,"title":44,"num":45},"cloud-resources","Cloud resources",11,{"slug":47,"title":48,"num":49},"what-runs-on-each-node","What runs on each node",12,{"slug":51,"title":52,"num":53},"the-monthly-bill","The monthly bill",13,{"slug":55,"title":56,"num":57},"project-databases","Project databases",14,{"slug":59,"title":60,"num":61},"pgbouncer-and-connection-limits","PgBouncer and connection limits",15,{"slug":63,"title":64,"num":65},"backups","Backups",16,{"slug":67,"title":68,"num":69},"tailscale","Tailscale",17,{"slug":71,"title":72,"num":73},"alerts","Alerts",18,{"slug":75,"title":76,"num":77},"move-from-an-existing-server","Move from an existing server",19,{"slug":79,"title":80,"num":81},"operations","Operations",20,{"slug":83,"title":84,"num":85},"troubleshooting","Troubleshooting",21,{"slug":87,"title":88,"num":89},"security","Security",22,{"slug":91,"title":92,"num":93},"limits","Limits",23,{"slug":95,"title":96,"num":97},"test-status","Test status",24,{"slug":99,"title":100,"num":101},"code-structure","Code structure",25,{"slug":103,"title":104,"num":105},"development","Development",26,{"slug":107,"title":108,"num":109},"references","References",null],"uses":{}},{"type":"data","data":[{"doc":1,"prev":20,"next":23},{"slug":2,"num":3,"title":4,"html":5,"toc":6,"summary":19},"backups",16,"Backups","\u003Cp>Backups use pgBackRest and S3-compatible storage, for example Hetzner Object\nStorage.\u003C/p>\n\u003Ch3 id=\"set-up\">\u003Ca class=\"anchor\" href=\"#set-up\" aria-hidden=\"true\">#\u003C/a>Set up\u003C/h3>\n\u003Col>\n\u003Cli>Create a bucket and an access key in your storage service.\u003C/li>\n\u003Cli>Run \u003Ccode>up\u003C/code> with the backup flags:\u003C/li>\n\u003C/ol>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">export\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> PGHA_S3_ACCESS_KEY\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">...\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">export\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> PGHA_S3_SECRET_KEY\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">...\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> up\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  --backup-endpoint\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> fsn1.your-objectstorage.com\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  --backup-bucket\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> my-pg-backups\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Ch3 id=\"what-you-get\">\u003Ca class=\"anchor\" href=\"#what-you-get\" aria-hidden=\"true\">#\u003C/a>What you get\u003C/h3>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Item\u003C/th>\u003Cth>Value\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>WAL archiving\u003C/td>\u003Ctd>Continuous, from the leader\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Schedule\u003C/td>\u003Ctd>Each day at 01:00 UTC (plus up to 5 minutes)\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Type\u003C/td>\u003Ctd>Full on Sunday, differential on other days\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>First backup\u003C/td>\u003Ctd>About 15 minutes after the nodes start\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Retention\u003C/td>\u003Ctd>2 full backups (\u003Ccode>--backup-keep-full\u003C/code>)\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Encryption\u003C/td>\u003Ctd>AES-256, passphrase in the state file\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Compression\u003C/td>\u003Ctd>\u003Ccode>zst\u003C/code>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Repository path\u003C/td>\u003Ctd>\u003Ccode>/pgha/&lt;name&gt;\u003C/code> in the bucket\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>The timer runs on all nodes. The script \u003Ccode>/usr/local/sbin/pgha-backup\u003C/code> makes\na backup only on the node that is the leader at that time.\u003C/p>\n\u003Ch3 id=\"manage\">\u003Ca class=\"anchor\" href=\"#manage\" aria-hidden=\"true\">#\u003C/a>Manage\u003C/h3>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> backup\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> list\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> backup\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> run\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --type\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> full\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> backup\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> check\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Ch3 id=\"restore\">\u003Ca class=\"anchor\" href=\"#restore\" aria-hidden=\"true\">#\u003C/a>Restore\u003C/h3>\n\u003Cp>Restore is a manual task. Test your backups regularly.\u003C/p>\n\u003Cp>To test a backup, restore it to a spare folder on one node:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">ssh\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> root@\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">&#x3C;\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">nod\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">e\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">runuser\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -u\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> postgres\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgbackrest\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --stanza=\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">&#x3C;\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">name\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">>\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  --pg1-path=/mnt/pgdata/restore-test\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> restore\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>To restore to a point in time, add\n\u003Ccode>--type=time --target=&quot;2026-10-05 12:00:00+00&quot;\u003C/code>.\u003C/p>\n\u003Cp>For a full disaster recovery, read the pgBackRest and Patroni documents\nbefore you start. The usual steps are: stop Patroni on all nodes, restore on\none node, start Patroni on that node, then let the other nodes copy from it.\u003C/p>\n\u003Cp>Backups are set at node creation. An \u003Ccode>up\u003C/code> on a live cluster does not add\nbackups.\u003C/p>\n",[7,10,13,16],{"id":8,"text":9},"set-up","Set up",{"id":11,"text":12},"what-you-get","What you get",{"id":14,"text":15},"manage","Manage",{"id":17,"text":18},"restore","Restore","Backups use pgBackRest and S3-compatible storage, for example Hetzner Object Storage.",{"slug":21,"title":22},"pgbouncer-and-connection-limits","PgBouncer and connection limits",{"slug":24,"title":25},"tailscale","Tailscale"],"uses":{"params":["slug"]}}]}
