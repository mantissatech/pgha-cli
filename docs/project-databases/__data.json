{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,6,10,14,18,22,26,30,34,38,42,46,50,54,58,62,66,70,74,78,82,86,90,94,98],{"slug":3,"title":4,"num":5},"what-pgha-does","What pgha does",1,{"slug":7,"title":8,"num":9},"architecture","Architecture",2,{"slug":11,"title":12,"num":13},"requirements","Requirements",3,{"slug":15,"title":16,"num":17},"install","Install",4,{"slug":19,"title":20,"num":21},"quick-start","Quick start",5,{"slug":23,"title":24,"num":25},"command-reference","Command reference",6,{"slug":27,"title":28,"num":29},"environment-variables","Environment variables",7,{"slug":31,"title":32,"num":33},"the-state-file","The state file",8,{"slug":35,"title":36,"num":37},"cloud-resources","Cloud resources",9,{"slug":39,"title":40,"num":41},"what-runs-on-each-node","What runs on each node",10,{"slug":43,"title":44,"num":45},"the-monthly-bill","The monthly bill",11,{"slug":47,"title":48,"num":49},"project-databases","Project databases",12,{"slug":51,"title":52,"num":53},"pgbouncer-and-connection-limits","PgBouncer and connection limits",13,{"slug":55,"title":56,"num":57},"backups","Backups",14,{"slug":59,"title":60,"num":61},"tailscale","Tailscale",15,{"slug":63,"title":64,"num":65},"alerts","Alerts",16,{"slug":67,"title":68,"num":69},"move-from-an-existing-server","Move from an existing server",17,{"slug":71,"title":72,"num":73},"operations","Operations",18,{"slug":75,"title":76,"num":77},"troubleshooting","Troubleshooting",19,{"slug":79,"title":80,"num":81},"security","Security",20,{"slug":83,"title":84,"num":85},"limits","Limits",21,{"slug":87,"title":88,"num":89},"test-status","Test status",22,{"slug":91,"title":92,"num":93},"code-structure","Code structure",23,{"slug":95,"title":96,"num":97},"development","Development",24,{"slug":99,"title":100,"num":101},"references","References",null],"uses":{}},{"type":"data","data":[{"doc":1,"prev":8,"next":11},{"slug":2,"num":3,"title":4,"html":5,"toc":6,"summary":7},"project-databases",12,"Project databases","\u003Cp>Each project gets its own database and its own login.\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> db\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> create\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> shop_api\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\"># Database ready: shop_api\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\"># Read-write: postgresql://shop_api:&#x3C;password>@10.0.1.x:5432/shop_api\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\"># Read-only:  postgresql://shop_api:&#x3C;password>@10.0.1.x:5433/shop_api\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>What \u003Ccode>db create\u003C/code> does:\u003C/p>\n\u003Col>\n\u003Cli>Creates the login role \u003Ccode>shop_api\u003C/code> with a random password.\u003C/li>\n\u003Cli>Creates the database \u003Ccode>shop_api\u003C/code>. The role owns it.\u003C/li>\n\u003Cli>Removes access for all other roles (\u003Ccode>REVOKE ALL ... FROM PUBLIC\u003C/code>).\u003C/li>\n\u003Cli>Stores the password in the state file.\u003C/li>\n\u003C/ol>\n\u003Cp>Rules:\u003C/p>\n\u003Cul>\n\u003Cli>A second \u003Ccode>db create\u003C/code> for the same name keeps the same password.\u003C/li>\n\u003Cli>Port 5432 goes to the leader. Port 5433 goes to the replicas.\u003C/li>\n\u003Cli>Replicas can be a short time behind the leader. Do not read your own\nwrites from port 5433.\u003C/li>\n\u003Cli>The connection string uses the private load balancer address. Your\napplications must be on the same Hetzner private network.\u003C/li>\n\u003Cli>\u003Ccode>--public\u003C/code> uses the public address. This needs \u003Ccode>up --public-lb\u003C/code>. Use a\ncluster with \u003Ccode>--tls required\u003C/code> for this, or set \u003Ccode>sslmode=require\u003C/code> in the\nclient. With \u003Ccode>--tls off\u003C/code>, data on a public address is not encrypted.\u003C/li>\n\u003Cli>With \u003Ccode>--tls required\u003C/code>, the connection strings end in \u003Ccode>?sslmode=require\u003C/code>.\u003C/li>\n\u003Cli>\u003Ccode>db list\u003C/code> shows \u003Ccode>PASSWORD\u003C/code> for a database that this tool did not create.\u003C/li>\n\u003C/ul>\n\u003Cp>The \u003Ccode>db\u003C/code> commands use SSH to the leader and run \u003Ccode>psql\u003C/code> as the \u003Ccode>postgres\u003C/code>\noperating system user.\u003C/p>\n",[],"Each project gets its own database and its own login.",{"slug":9,"title":10},"the-monthly-bill","The monthly bill",{"slug":12,"title":13},"pgbouncer-and-connection-limits","PgBouncer and connection limits"],"uses":{"params":["slug"]}}]}
