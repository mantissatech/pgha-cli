,"References",null],"uses":{}},{"type":"data","data":[{"doc":1,"prev":8,"next":11},{"slug":2,"num":3,"title":4,"html":5,"toc":6,"summary":7},"environment-variables",9,"Environment variables","\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Variable\u003C/th>\u003Cth>Used by\u003C/th>\u003Cth>Meaning\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode>HCLOUD_TOKEN\u003C/code>\u003C/td>\u003Ctd>all\u003C/td>\u003Ctd>Hetzner API token.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_S3_ACCESS_KEY\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>up\u003C/code>\u003C/td>\u003Ctd>S3 access key for backups.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_S3_SECRET_KEY\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>up\u003C/code>\u003C/td>\u003Ctd>S3 secret key for backups.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>TS_API_KEY\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>up\u003C/code>, \u003Ccode>adopt\u003C/code>, \u003Ccode>down\u003C/code>\u003C/td>\u003Ctd>Tailscale API access token. \u003Ccode>TAILSCALE_API_KEY\u003C/code> is the same.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>TS_AUTHKEY\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>up\u003C/code>, \u003Ccode>adopt\u003C/code>\u003C/td>\u003Ctd>Tailscale auth key, used only when no API token is set.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_ALERT_WEBHOOK\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>up --monitor\u003C/code>, \u003Ccode>adopt --monitor\u003C/code>, \u003Ccode>monitor install\u003C/code>\u003C/td>\u003Ctd>HTTPS webhook for alerts.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_SOURCE_URL\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>db import\u003C/code>\u003C/td>\u003Ctd>Source URL, in place of \u003Ccode>--from\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_CONSOLE_TOKEN\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>console\u003C/code>\u003C/td>\u003Ctd>Login token, in place of a random one.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_CONSOLE_LISTEN\u003C/code>, \u003Ccode>PGHA_CONSOLE_HOST\u003C/code>, \u003Ccode>PGHA_CONSOLE_PORT\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>console\u003C/code>\u003C/td>\u003Ctd>Bind address, in place of \u003Ccode>--listen\u003C/code>, \u003Ccode>--host\u003C/code>, \u003Ccode>--port\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_CONSOLE_ALLOWED_HOSTS\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>console\u003C/code>\u003C/td>\u003Ctd>Extra \u003Ccode>Host\u003C/code> names, comma separated.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_CONSOLE_AUTH\u003C/code>, \u003Ccode>PGHA_CONSOLE_AUTH_ALLOW\u003C/code>, \u003Ccode>PGHA_CONSOLE_AUTH_METHODS\u003C/code>, \u003Ccode>PGHA_CONSOLE_SESSION_TTL\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>console\u003C/code>\u003C/td>\u003Ctd>Sign-in settings, see 6.11.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_FIREBASE_PROJECT_ID\u003C/code>, \u003Ccode>PGHA_FIREBASE_API_KEY\u003C/code>, \u003Ccode>PGHA_FIREBASE_AUTH_DOMAIN\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>console\u003C/code>\u003C/td>\u003Ctd>Firebase sign-in.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_SUPABASE_URL\u003C/code>, \u003Ccode>PGHA_SUPABASE_ANON_KEY\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>console\u003C/code>\u003C/td>\u003Ctd>Supabase sign-in.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_MODE\u003C/code>\u003C/td>\u003Ctd>all\u003C/td>\u003Ctd>\u003Ccode>local\u003C/code> or \u003Ccode>remote\u003C/code>, in place of \u003Ccode>--mode\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_DB\u003C/code>\u003C/td>\u003Ctd>all\u003C/td>\u003Ctd>SQLite state file, in place of \u003Ccode>--db\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_DATABASE_URL\u003C/code>\u003C/td>\u003Ctd>all\u003C/td>\u003Ctd>Remote state URL, in place of \u003Ccode>--database-url\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>GOOGLE_APPLICATION_CREDENTIALS\u003C/code>\u003C/td>\u003Ctd>all, with \u003Ccode>firestore://\u003C/code>\u003C/td>\u003Ctd>Service account key file for Firestore.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_SSH_PRIVATE_KEY\u003C/code>, \u003Ccode>PGHA_SSH_PRIVATE_KEY_FILE\u003C/code>\u003C/td>\u003Ctd>container image\u003C/td>\u003Ctd>SSH private key text or file, used when the volume has no key yet.\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>The tool stores the S3 keys, the Tailscale API token, and the webhook in the\nstate file on the first run that needs them. A later command does not\nneed the variables. A stray \u003Ccode>PGHA_ALERT_WEBHOOK\u003C/code> does not change the file\nunless \u003Ccode>--monitor\u003C/code> is set or \u003Ccode>monitor install\u003C/code> runs.\u003C/p>\n",[],"The tool stores the S3 keys, the Tailscale API token, and the webhook in the state file on the first run that needs them. A later command does not need the v…",{"slug":9,"title":10},"command-reference","Command reference",{"slug":12,"title":13},"the-state-file","The state file"],"uses":{"params":["slug"]}}]}
