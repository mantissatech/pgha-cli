{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,6,10,14,18,22,26,30,34,38,42,46,50,54,58,62,66,70,74,78,82,86,90,94,98,102,106],{"slug":3,"title":4,"num":5},"what-pgha-does","What pgha does",1,{"slug":7,"title":8,"num":9},"architecture","Architecture",2,{"slug":11,"title":12,"num":13},"requirements","Requirements",3,{"slug":15,"title":16,"num":17},"install","Install",4,{"slug":19,"title":20,"num":21},"container-image","Container image",5,{"slug":23,"title":24,"num":25},"run-the-console-on-a-server","Run the console on a server",6,{"slug":27,"title":28,"num":29},"quick-start","Quick start",7,{"slug":31,"title":32,"num":33},"command-reference","Command reference",8,{"slug":35,"title":36,"num":37},"environment-variables","Environment variables",9,{"slug":39,"title":40,"num":41},"the-state-file","The state file",10,{"slug":43,"title":44,"num":45},"cloud-resources","Cloud resources",11,{"slug":47,"title":48,"num":49},"what-runs-on-each-node","What runs on each node",12,{"slug":51,"title":52,"num":53},"the-monthly-bill","The monthly bill",13,{"slug":55,"title":56,"num":57},"project-databases","Project databases",14,{"slug":59,"title":60,"num":61},"pgbouncer-and-connection-limits","PgBouncer and connection limits",15,{"slug":63,"title":64,"num":65},"backups","Backups",16,{"slug":67,"title":68,"num":69},"tailscale","Tailscale",17,{"slug":71,"title":72,"num":73},"alerts","Alerts",18,{"slug":75,"title":76,"num":77},"move-from-an-existing-server","Move from an existing server",19,{"slug":79,"title":80,"num":81},"operations","Operations",20,{"slug":83,"title":84,"num":85},"troubleshooting","Troubleshooting",21,{"slug":87,"title":88,"num":89},"security","Security",22,{"slug":91,"title":92,"num":93},"limits","Limits",23,{"slug":95,"title":96,"num":97},"test-status","Test status",24,{"slug":99,"title":100,"num":101},"code-structure","Code structure",25,{"slug":103,"title":104,"num":105},"development","Development",26,{"slug":107,"title":108,"num":109},"references","References",null],"uses":{}},{"type":"data","data":[{"doc":1,"prev":23,"next":26},{"slug":2,"num":3,"title":4,"html":5,"toc":6,"summary":22},"pgbouncer-and-connection-limits",15,"PgBouncer and connection limits","\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> up\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --pgbouncer\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> db\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> create\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> shop_api\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --connections\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> 10\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Ch3 id=\"what-changes-with---pgbouncer\">\u003Ca class=\"anchor\" href=\"#what-changes-with---pgbouncer\" aria-hidden=\"true\">#\u003C/a>What changes with \u003Ccode>--pgbouncer\u003C/code>\u003C/h3>\n\u003Cul>\n\u003Cli>Each node runs PgBouncer on port 6432, in front of its local Postgres.\u003C/li>\n\u003Cli>The load balancer sends ports 5432 and 5433 to port 6432 on the nodes.\u003C/li>\n\u003Cli>Connection strings do not change.\u003C/li>\n\u003C/ul>\n\u003Ch3 id=\"pgbouncer-settings\">\u003Ca class=\"anchor\" href=\"#pgbouncer-settings\" aria-hidden=\"true\">#\u003C/a>PgBouncer settings\u003C/h3>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Setting\u003C/th>\u003Cth>Value\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode>pool_mode\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>transaction\u003C/code>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>default_pool_size\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>--pool-size\u003C/code> (default 20)\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>max_client_conn\u003C/code>\u003C/td>\u003Ctd>2000\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>max_prepared_statements\u003C/code>\u003C/td>\u003Ctd>200\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>auth_type\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>scram-sha-256\u003C/code>\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Ch3 id=\"login-check\">\u003Ca class=\"anchor\" href=\"#login-check\" aria-hidden=\"true\">#\u003C/a>Login check\u003C/h3>\n\u003Cp>PgBouncer does not keep a user list. It connects to the \u003Ccode>postgres\u003C/code> database\nas the role \u003Ccode>pgbouncer\u003C/code> and calls the function \u003Ccode>public.pgha_user_lookup\u003C/code>.\nCluster setup creates this role and function. \u003Ccode>db create\u003C/code> creates them again\nif they are missing. The function does not return superusers or replication\nroles, so these roles cannot log in through PgBouncer.\u003C/p>\n\u003Ch3 id=\"connection-limits\">\u003Ca class=\"anchor\" href=\"#connection-limits\" aria-hidden=\"true\">#\u003C/a>Connection limits\u003C/h3>\n\u003Cp>\u003Ccode>--connections N\u003C/code> sets two things:\u003C/p>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Where\u003C/th>\u003Cth>What\u003C/th>\u003Cth>Effect\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>Postgres\u003C/td>\u003Ctd>\u003Ccode>ALTER ROLE ... CONNECTION LIMIT N\u003C/code>\u003C/td>\u003Ctd>Hard limit.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>PgBouncer\u003C/td>\u003Ctd>\u003Ccode>pool_size=N\u003C/code> for the database\u003C/td>\u003Ctd>Extra queries wait.\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>Without PgBouncer, a client above the limit gets the error\n\u003Ccode>too many connections for role\u003C/code>.\u003C/p>\n\u003Cp>The tool writes the limits to \u003Ccode>/etc/pgbouncer/pgha-databases.ini\u003C/code> on each\nnode and reloads PgBouncer. If a node was not reachable, run \u003Ccode>pgha db sync\u003C/code>.\u003C/p>\n\u003Cp>Keep the total of all pool sizes below about 180. Postgres allows 200\nconnections, and Patroni and replication use some.\u003C/p>\n\u003Ch3 id=\"what-does-not-work-in-transaction-mode\">\u003Ca class=\"anchor\" href=\"#what-does-not-work-in-transaction-mode\" aria-hidden=\"true\">#\u003C/a>What does not work in transaction mode\u003C/h3>\n\u003Cul>\n\u003Cli>\u003Ccode>SET\u003C/code> for the session (use \u003Ccode>SET LOCAL\u003C/code> in a transaction).\u003C/li>\n\u003Cli>\u003Ccode>LISTEN\u003C/code> and \u003Ccode>NOTIFY\u003C/code> listeners.\u003C/li>\n\u003Cli>Session advisory locks.\u003C/li>\n\u003Cli>Temporary tables that you keep across transactions.\u003C/li>\n\u003C/ul>\n\u003Cp>Prepared statements work. The Go \u003Ccode>pgx\u003C/code> driver works in its default mode.\u003C/p>\n",[7,10,13,16,19],{"id":8,"text":9},"what-changes-with---pgbouncer","What changes with --pgbouncer",{"id":11,"text":12},"pgbouncer-settings","PgBouncer settings",{"id":14,"text":15},"login-check","Login check",{"id":17,"text":18},"connection-limits","Connection limits",{"id":20,"text":21},"what-does-not-work-in-transaction-mode","What does not work in transaction mode","PgBouncer does not keep a user list. It connects to the postgres database as the role pgbouncer and calls the function public.pgha user lookup. Cluster setup…",{"slug":24,"title":25},"project-databases","Project databases",{"slug":27,"title":28},"backups","Backups"],"uses":{"params":["slug"]}}]}
