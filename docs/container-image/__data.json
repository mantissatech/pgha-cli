{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,6,10,14,18,22,26,30,34,38,42,46,50,54,58,62,66,70,74,78,82,86,90,94,98,102,106],{"slug":3,"title":4,"num":5},"what-pgha-does","What pgha does",1,{"slug":7,"title":8,"num":9},"architecture","Architecture",2,{"slug":11,"title":12,"num":13},"requirements","Requirements",3,{"slug":15,"title":16,"num":17},"install","Install",4,{"slug":19,"title":20,"num":21},"container-image","Container image",5,{"slug":23,"title":24,"num":25},"run-the-console-on-a-server","Run the console on a server",6,{"slug":27,"title":28,"num":29},"quick-start","Quick start",7,{"slug":31,"title":32,"num":33},"command-reference","Command reference",8,{"slug":35,"title":36,"num":37},"environment-variables","Environment variables",9,{"slug":39,"title":40,"num":41},"the-state-file","The state file",10,{"slug":43,"title":44,"num":45},"cloud-resources","Cloud resources",11,{"slug":47,"title":48,"num":49},"what-runs-on-each-node","What runs on each node",12,{"slug":51,"title":52,"num":53},"the-monthly-bill","The monthly bill",13,{"slug":55,"title":56,"num":57},"project-databases","Project databases",14,{"slug":59,"title":60,"num":61},"pgbouncer-and-connection-limits","PgBouncer and connection limits",15,{"slug":63,"title":64,"num":65},"backups","Backups",16,{"slug":67,"title":68,"num":69},"tailscale","Tailscale",17,{"slug":71,"title":72,"num":73},"alerts","Alerts",18,{"slug":75,"title":76,"num":77},"move-from-an-existing-server","Move from an existing server",19,{"slug":79,"title":80,"num":81},"operations","Operations",20,{"slug":83,"title":84,"num":85},"troubleshooting","Troubleshooting",21,{"slug":87,"title":88,"num":89},"security","Security",22,{"slug":91,"title":92,"num":93},"limits","Limits",23,{"slug":95,"title":96,"num":97},"test-status","Test status",24,{"slug":99,"title":100,"num":101},"code-structure","Code structure",25,{"slug":103,"title":104,"num":105},"development","Development",26,{"slug":107,"title":108,"num":109},"references","References",null],"uses":{}},{"type":"data","data":[{"doc":1,"prev":32,"next":35},{"slug":2,"num":3,"title":4,"html":5,"toc":6,"summary":31},"container-image",5,"Container image","\u003Cp>Each release also ships a free, public container image with the CLI and\nthe web console. No login is needed to pull it.\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">docker\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pull\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> ghcr.io/mantissatech/pgha:latest\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Tag\u003C/th>\u003Cth>Meaning\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode>latest\u003C/code>\u003C/td>\u003Ctd>The newest stable release.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>1.2.3\u003C/code>\u003C/td>\u003Ctd>One release.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>1.2\u003C/code>\u003C/td>\u003Ctd>The newest patch release of 1.2.\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>A prerelease such as \u003Ccode>1.3.0-rc.1\u003C/code> gets only its own tag. The image runs on\n\u003Ccode>linux/amd64\u003C/code> and \u003Ccode>linux/arm64\u003C/code>.\u003C/p>\n\u003Cp>What is in the image:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Ccode>pgha\u003C/code>, the OpenSSH client and CA certificates, on Alpine Linux.\u003C/li>\n\u003Cli>It runs as the user \u003Ccode>pgha\u003C/code> (uid \u003Ccode>10001\u003C/code>), not as root.\u003C/li>\n\u003Cli>\u003Ccode>/data\u003C/code> is a volume. It holds the state file \u003Ccode>/data/pgha.db\u003C/code> and the SSH\nkey in \u003Ccode>/data/.ssh\u003C/code>. It is also the home directory of \u003Ccode>pgha\u003C/code>.\u003C/li>\n\u003Cli>The default command is \u003Ccode>console\u003C/code>. It listens on port 7070.\u003C/li>\n\u003C/ul>\n\u003Ch3 id=\"run-the-web-console\">\u003Ca class=\"anchor\" href=\"#run-the-web-console\" aria-hidden=\"true\">#\u003C/a>Run the web console\u003C/h3>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">export\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> HCLOUD_TOKEN\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">your-read-write-token\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">docker\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> run\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -d\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --name\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  -p\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> 127.0.0.1:7070:7070\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  -v\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha-data:/data\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  -e\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> HCLOUD_TOKEN\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  -e\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> PGHA_CONSOLE_TOKEN=\"$(\u003C/span>\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">openssl\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> rand \u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">-hex\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> 32\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">)\"\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  --restart\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> unless-stopped\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  --stop-timeout\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> 1800\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">  ghcr.io/mantissatech/pgha:latest\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">docker\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> logs\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha\u003C/span>\u003Cspan style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">    # prints the sign-in link\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cul>\n\u003Cli>\u003Ccode>-p 127.0.0.1:7070:7070\u003C/code> opens the port on your computer only. Open the\nlink from \u003Ccode>docker logs\u003C/code> in a browser.\u003C/li>\n\u003Cli>With \u003Ccode>PGHA_CONSOLE_TOKEN\u003C/code> the link stays the same after a restart.\nWithout it, each start makes a new token.\u003C/li>\n\u003Cli>The console answers only the names \u003Ccode>localhost\u003C/code> and \u003Ccode>127.0.0.1\u003C/code>. To use\nanother name, set \u003Ccode>PGHA_CONSOLE_ALLOWED_HOSTS\u003C/code>. Read\n\u003Ca href=\"/pgha-cli/docs/run-the-console-on-a-server/\">Run the console on a server\u003C/a>.\u003C/li>\n\u003Cli>\u003Ccode>docker stop\u003C/code> asks the console to stop. It waits for running tasks.\n\u003Ccode>--stop-timeout 1800\u003C/code> gives them 30 minutes before Docker kills them.\u003C/li>\n\u003C/ul>\n\u003Cp>Flags go after the image name, and the variables in\n\u003Ca href=\"/pgha-cli/docs/environment-variables/\">Environment variables\u003C/a> work with \u003Ccode>-e\u003C/code>:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">docker\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> run\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -d\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -p\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> 127.0.0.1:7070:7070\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -v\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha-data:/data\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -e\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> HCLOUD_TOKEN\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">  ghcr.io/mantissatech/pgha:latest\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> console\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --session-ttl\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> 8h\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Ch3 id=\"run-cli-commands\">\u003Ca class=\"anchor\" href=\"#run-cli-commands\" aria-hidden=\"true\">#\u003C/a>Run CLI commands\u003C/h3>\n\u003Cp>Every command works in the container. Give the command after the image\nname:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">alias\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> pgha\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">'docker run --rm -it -v pgha-data:/data -e HCLOUD_TOKEN -e PGHA_S3_ACCESS_KEY -e PGHA_S3_SECRET_KEY -e TS_API_KEY ghcr.io/mantissatech/pgha:latest'\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> estimate\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> up\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --name\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> prod\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --pgbouncer\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> status\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --name\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> prod\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> db\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> create\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> shop_api\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --name\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> prod\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cul>\n\u003Cli>\u003Ccode>-it\u003C/code> lets \u003Ccode>up\u003C/code> and \u003Ccode>down\u003C/code> ask before they change anything. In scripts,\nleave out \u003Ccode>-it\u003C/code> and pass \u003Ccode>--yes\u003C/code>.\u003C/li>\n\u003Cli>\u003Ccode>-e NAME\u003C/code> without a value copies the variable from your shell, when it\nis set.\u003C/li>\n\u003Cli>Use the same volume (\u003Ccode>pgha-data\u003C/code>) for the console and the commands. They\nthen share the state file and the SSH key.\u003C/li>\n\u003Cli>A command that reads a file, such as \u003Ccode>state import\u003C/code>, needs the file in\nthe container. Mount it: \u003Ccode>-v &quot;$PWD/backup.json:/in/backup.json:ro&quot;\u003C/code>.\u003C/li>\n\u003C/ul>\n\u003Ch3 id=\"the-ssh-key\">\u003Ca class=\"anchor\" href=\"#the-ssh-key\" aria-hidden=\"true\">#\u003C/a>The SSH key\u003C/h3>\n\u003Cp>pgha uses SSH to reach the nodes. At each start the image looks for a key\nin this order:\u003C/p>\n\u003Col>\n\u003Cli>\u003Ccode>/data/.ssh/id_ed25519\u003C/code>, when it exists.\u003C/li>\n\u003Cli>\u003Ccode>PGHA_SSH_PRIVATE_KEY\u003C/code> (the key text), or \u003Ccode>PGHA_SSH_PRIVATE_KEY_FILE\u003C/code>\n(a file path in the container). The key is saved as\n\u003Ccode>/data/.ssh/id_ed25519\u003C/code>.\u003C/li>\n\u003Cli>Otherwise it makes a new ed25519 key and prints a note.\u003C/li>\n\u003C/ol>\n\u003Cp>It writes \u003Ccode>id_ed25519.pub\u003C/code> next to the key. New clusters get that public\nkey. The key must not have a passphrase; there is no SSH agent in the\ncontainer.\u003C/p>\n\u003Cp>Show the public key:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">docker\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> run\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --rm\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -v\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha-data:/data\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --entrypoint\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> cat\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">  ghcr.io/mantissatech/pgha:latest\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> /data/.ssh/id_ed25519.pub\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>Clusters made before, with your own key, need that key. Copy it into the\nvolume once. This replaces a key that the image made:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">docker\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> run\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --rm\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -i\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -v\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha-data:/data\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --entrypoint\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> sh\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">  ghcr.io/mantissatech/pgha:latest\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  -c\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> 'umask 077; mkdir -p ~/.ssh; cat > ~/.ssh/id_ed25519; rm -f ~/.ssh/id_ed25519.pub'\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">  &#x3C;\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> ~/.ssh/id_ed25519\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>Or add the new public key to \u003Ccode>/root/.ssh/authorized_keys\u003C/code> on each node.\u003C/p>\n\u003Ch3 id=\"the-state-file\">\u003Ca class=\"anchor\" href=\"#the-state-file\" aria-hidden=\"true\">#\u003C/a>The state file\u003C/h3>\n\u003Cp>The state is \u003Ccode>/data/pgha.db\u003C/code> in the volume. To bring an existing\n\u003Ccode>pgha.db\u003C/code>, stop the console, then copy it in:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">docker\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> run\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --rm\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -i\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -v\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha-data:/data\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --entrypoint\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> sh\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">  ghcr.io/mantissatech/pgha:latest\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -c\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> 'umask 077; cat > /data/pgha.db'\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">  &#x3C;\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha.db\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>Remote state works too: \u003Ccode>-e PGHA_DATABASE_URL\u003C/code>. For Firestore, mount the\nservice account key and set \u003Ccode>GOOGLE_APPLICATION_CREDENTIALS\u003C/code> to its path in\nthe container. The file must be readable by uid \u003Ccode>10001\u003C/code>. Read\n\u003Ca href=\"/pgha-cli/docs/the-state-file/\">The state file\u003C/a>.\u003C/p>\n\u003Ch3 id=\"a-host-folder-in-place-of-a-volume\">\u003Ca class=\"anchor\" href=\"#a-host-folder-in-place-of-a-volume\" aria-hidden=\"true\">#\u003C/a>A host folder in place of a volume\u003C/h3>\n\u003Cp>A folder on the host works, when uid \u003Ccode>10001\u003C/code> owns it:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">sudo\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> mkdir\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -p\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> /srv/pgha/data\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">sudo\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> chown\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> 10001:10001\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> /srv/pgha/data\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">docker\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> run\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -d\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -p\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> 127.0.0.1:7070:7070\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -v\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> /srv/pgha/data:/data\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -e\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> HCLOUD_TOKEN\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">  ghcr.io/mantissatech/pgha:latest\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>When the image cannot write to \u003Ccode>/data\u003C/code>, it stops and prints the \u003Ccode>chown\u003C/code>\ncommand.\u003C/p>\n\u003Ch3 id=\"clusters-with-tailscale\">\u003Ca class=\"anchor\" href=\"#clusters-with-tailscale\" aria-hidden=\"true\">#\u003C/a>Clusters with Tailscale\u003C/h3>\n\u003Cp>With \u003Ccode>--tailscale\u003C/code>, the nodes have no public SSH. pgha reaches them on the\ntailnet. Run the container on a computer that is in the tailnet, with the\nhost network:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">docker\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> run\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -d\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --network\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> host\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -v\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha-data:/data\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -e\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> HCLOUD_TOKEN\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  -e\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> PGHA_CONSOLE_LISTEN=127.0.0.1:7070\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">  ghcr.io/mantissatech/pgha:latest\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>With \u003Ccode>--network host\u003C/code>, \u003Ccode>-p\u003C/code> does nothing. Set \u003Ccode>PGHA_CONSOLE_LISTEN\u003C/code>, or the\nconsole listens on all addresses of the host.\u003C/p>\n\u003Ch3 id=\"image-settings\">\u003Ca class=\"anchor\" href=\"#image-settings\" aria-hidden=\"true\">#\u003C/a>Image settings\u003C/h3>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Variable\u003C/th>\u003Cth>Value in the image\u003C/th>\u003Cth>Meaning\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode>HOME\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>/data\u003C/code>\u003C/td>\u003Ctd>Home of \u003Ccode>pgha\u003C/code>. ssh reads \u003Ccode>~/.ssh\u003C/code> from here.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_DB\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>/data/pgha.db\u003C/code>\u003C/td>\u003Ctd>The state file.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_CONSOLE_LISTEN\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>0.0.0.0:7070\u003C/code>\u003C/td>\u003Ctd>The console address inside the container.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_CONSOLE_ALLOWED_HOSTS\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>localhost\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>Host\u003C/code> names the console answers. \u003Ccode>127.0.0.1\u003C/code> and \u003Ccode>::1\u003C/code> are always allowed.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_SSH_PRIVATE_KEY\u003C/code>\u003C/td>\u003Ctd>not set\u003C/td>\u003Ctd>Private key text, used when \u003Ccode>/data/.ssh/id_ed25519\u003C/code> does not exist.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>PGHA_SSH_PRIVATE_KEY_FILE\u003C/code>\u003C/td>\u003Ctd>not set\u003C/td>\u003Ctd>Path of a private key file, same rule.\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Ch3 id=\"build-the-image\">\u003Ca class=\"anchor\" href=\"#build-the-image\" aria-hidden=\"true\">#\u003C/a>Build the image\u003C/h3>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">docker\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> build\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -t\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> .\u003C/span>\u003Cspan style=\"--shiki-light:#6A737D;--shiki-dark:#6A737D\">      # or: make image\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">docker\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> run\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --rm\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --version\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>The \u003Ccode>Dockerfile\u003C/code> builds the web console and pgha, then copies them into a\nsmall Alpine image. Build arguments \u003Ccode>VERSION\u003C/code>, \u003Ccode>COMMIT\u003C/code> and \u003Ccode>DATE\u003C/code> set the\n\u003Ccode>--version\u003C/code> text. A multi-platform build cross-compiles; only the last\nstage needs emulation:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">docker\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> buildx\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> build\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --platform\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> linux/amd64,linux/arm64\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -t\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> .\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n",[7,10,13,16,19,22,25,28],{"id":8,"text":9},"run-the-web-console","Run the web console",{"id":11,"text":12},"run-cli-commands","Run CLI commands",{"id":14,"text":15},"the-ssh-key","The SSH key",{"id":17,"text":18},"the-state-file","The state file",{"id":20,"text":21},"a-host-folder-in-place-of-a-volume","A host folder in place of a volume",{"id":23,"text":24},"clusters-with-tailscale","Clusters with Tailscale",{"id":26,"text":27},"image-settings","Image settings",{"id":29,"text":30},"build-the-image","Build the image","Each release also ships a free, public container image with the CLI and the web console. No login is needed to pull it.",{"slug":33,"title":34},"install","Install",{"slug":36,"title":37},"run-the-console-on-a-server","Run the console on a server"],"uses":{"params":["slug"]}}]}
