{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,6,10,14,18,22,26,30,34,38,42,46,50,54,58,62,66,70,74,78,82,86,90,94,98],{"slug":3,"title":4,"num":5},"what-pgha-does","What pgha does",1,{"slug":7,"title":8,"num":9},"architecture","Architecture",2,{"slug":11,"title":12,"num":13},"requirements","Requirements",3,{"slug":15,"title":16,"num":17},"install","Install",4,{"slug":19,"title":20,"num":21},"quick-start","Quick start",5,{"slug":23,"title":24,"num":25},"command-reference","Command reference",6,{"slug":27,"title":28,"num":29},"environment-variables","Environment variables",7,{"slug":31,"title":32,"num":33},"the-state-file","The state file",8,{"slug":35,"title":36,"num":37},"cloud-resources","Cloud resources",9,{"slug":39,"title":40,"num":41},"what-runs-on-each-node","What runs on each node",10,{"slug":43,"title":44,"num":45},"the-monthly-bill","The monthly bill",11,{"slug":47,"title":48,"num":49},"project-databases","Project databases",12,{"slug":51,"title":52,"num":53},"pgbouncer-and-connection-limits","PgBouncer and connection limits",13,{"slug":55,"title":56,"num":57},"backups","Backups",14,{"slug":59,"title":60,"num":61},"tailscale","Tailscale",15,{"slug":63,"title":64,"num":65},"alerts","Alerts",16,{"slug":67,"title":68,"num":69},"move-from-an-existing-server","Move from an existing server",17,{"slug":71,"title":72,"num":73},"operations","Operations",18,{"slug":75,"title":76,"num":77},"troubleshooting","Troubleshooting",19,{"slug":79,"title":80,"num":81},"security","Security",20,{"slug":83,"title":84,"num":85},"limits","Limits",21,{"slug":87,"title":88,"num":89},"test-status","Test status",22,{"slug":91,"title":92,"num":93},"code-structure","Code structure",23,{"slug":95,"title":96,"num":97},"development","Development",24,{"slug":99,"title":100,"num":101},"references","References",null],"uses":{}},{"type":"data","data":[{"doc":1,"prev":14,"next":17},{"slug":2,"num":3,"title":4,"html":5,"toc":6,"summary":13},"cloud-resources",9,"Cloud resources","\u003Cp>For a cluster with the name \u003Ccode>prod\u003C/code>:\u003C/p>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Resource\u003C/th>\u003Cth>Name\u003C/th>\u003Cth>Notes\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>SSH key\u003C/td>\u003Ctd>\u003Ccode>prod-key\u003C/code>\u003C/td>\u003Ctd>Only if the tool uploads your public key.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Network\u003C/td>\u003Ctd>\u003Ccode>prod-net\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>10.0.0.0/16\u003C/code> with subnet \u003Ccode>10.0.1.0/24\u003C/code>. With \u003Ccode>--network\u003C/code>, the cluster uses that network and does not label it.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Firewall\u003C/td>\u003Ctd>\u003Ccode>prod-fw\u003C/code>\u003C/td>\u003Ctd>See below.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Volumes\u003C/td>\u003Ctd>\u003Ccode>prod-pg1-data\u003C/code> ...\u003C/td>\u003Ctd>Format \u003Ccode>ext4\u003C/code>, one for each node.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Servers\u003C/td>\u003Ctd>\u003Ccode>prod-pg1\u003C/code> ...\u003C/td>\u003Ctd>Private addresses \u003Ccode>10.0.1.11\u003C/code>, \u003Ccode>.12\u003C/code>, \u003Ccode>.13\u003C/code>. On an existing network, the first free addresses from host 11.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Load balancer\u003C/td>\u003Ctd>\u003Ccode>prod-lb\u003C/code>\u003C/td>\u003Ctd>Private address in the subnet.\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>All resources have the label \u003Ccode>pgha-cluster=prod\u003C/code>. \u003Ccode>status\u003C/code> and \u003Ccode>down\u003C/code> find\nthe resources with this label.\u003C/p>\n\u003Cp>Other labels on servers:\u003C/p>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Label\u003C/th>\u003Cth>Meaning\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode>pgha-ssh=public\u003C/code> or \u003Ccode>tailscale\u003C/code>\u003C/td>\u003Ctd>How the tool reaches the node with SSH.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>pgha-pgbouncer=true\u003C/code>\u003C/td>\u003Ctd>The node runs PgBouncer.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>pgha-adopted=true\u003C/code>\u003C/td>\u003Ctd>The server existed before the cluster.\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Ch3 id=\"firewall-rules\">\u003Ca class=\"anchor\" href=\"#firewall-rules\" aria-hidden=\"true\">#\u003C/a>Firewall rules\u003C/h3>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Mode\u003C/th>\u003Cth>Public inbound rules\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>Default\u003C/td>\u003Ctd>TCP 22 from the \u003Ccode>--ssh-allow\u003C/code> ranges.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>--tailscale\u003C/code>\u003C/td>\u003Ctd>UDP 41641 from all addresses. No SSH rule.\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>Hetzner firewalls do not filter the private network. The Postgres, Patroni,\netcd and PgBouncer ports are not open to the internet.\u003C/p>\n\u003Ch3 id=\"ports\">\u003Ca class=\"anchor\" href=\"#ports\" aria-hidden=\"true\">#\u003C/a>Ports\u003C/h3>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Port\u003C/th>\u003Cth>Service\u003C/th>\u003Cth>Reachable from\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>22\u003C/td>\u003Ctd>SSH\u003C/td>\u003Ctd>Internet (default) or tailnet only\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>5432\u003C/td>\u003Ctd>Postgres\u003C/td>\u003Ctd>Private network, localhost\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>6432\u003C/td>\u003Ctd>PgBouncer\u003C/td>\u003Ctd>Private network, localhost\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>8008\u003C/td>\u003Ctd>Patroni REST API\u003C/td>\u003Ctd>Private network\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>2379, 2380\u003C/td>\u003Ctd>etcd\u003C/td>\u003Ctd>Private network, localhost\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n",[7,10],{"id":8,"text":9},"firewall-rules","Firewall rules",{"id":11,"text":12},"ports","Ports","For a cluster with the name prod:",{"slug":15,"title":16},"the-state-file","The state file",{"slug":18,"title":19},"what-runs-on-each-node","What runs on each node"],"uses":{"params":["slug"]}}]}
