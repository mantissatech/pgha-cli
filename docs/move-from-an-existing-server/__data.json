{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,6,10,14,18,22,26,30,34,38,42,46,50,54,58,62,66,70,74,78,82,86,90,94,98],{"slug":3,"title":4,"num":5},"what-pgha-does","What pgha does",1,{"slug":7,"title":8,"num":9},"architecture","Architecture",2,{"slug":11,"title":12,"num":13},"requirements","Requirements",3,{"slug":15,"title":16,"num":17},"install","Install",4,{"slug":19,"title":20,"num":21},"quick-start","Quick start",5,{"slug":23,"title":24,"num":25},"command-reference","Command reference",6,{"slug":27,"title":28,"num":29},"environment-variables","Environment variables",7,{"slug":31,"title":32,"num":33},"the-state-file","The state file",8,{"slug":35,"title":36,"num":37},"cloud-resources","Cloud resources",9,{"slug":39,"title":40,"num":41},"what-runs-on-each-node","What runs on each node",10,{"slug":43,"title":44,"num":45},"the-monthly-bill","The monthly bill",11,{"slug":47,"title":48,"num":49},"project-databases","Project databases",12,{"slug":51,"title":52,"num":53},"pgbouncer-and-connection-limits","PgBouncer and connection limits",13,{"slug":55,"title":56,"num":57},"backups","Backups",14,{"slug":59,"title":60,"num":61},"tailscale","Tailscale",15,{"slug":63,"title":64,"num":65},"alerts","Alerts",16,{"slug":67,"title":68,"num":69},"move-from-an-existing-server","Move from an existing server",17,{"slug":71,"title":72,"num":73},"operations","Operations",18,{"slug":75,"title":76,"num":77},"troubleshooting","Troubleshooting",19,{"slug":79,"title":80,"num":81},"security","Security",20,{"slug":83,"title":84,"num":85},"limits","Limits",21,{"slug":87,"title":88,"num":89},"test-status","Test status",22,{"slug":91,"title":92,"num":93},"code-structure","Code structure",23,{"slug":95,"title":96,"num":97},"development","Development",24,{"slug":99,"title":100,"num":101},"references","References",null],"uses":{}},{"type":"data","data":[{"doc":1,"prev":14,"next":17},{"slug":2,"num":3,"title":4,"html":5,"toc":6,"summary":13},"move-from-an-existing-server",17,"Move from an existing server","\u003Cp>There are two paths. Path 1 is safer.\u003C/p>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>\u003C/th>\u003Cth>Path 1: import\u003C/th>\u003Cth>Path 2: adopt\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>Old server\u003C/td>\u003Ctd>Not changed\u003C/td>\u003Ctd>Becomes node one\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Downtime\u003C/td>\u003Ctd>Time of the copy (if you stop writes)\u003C/td>\u003Ctd>One Postgres restart\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Risk\u003C/td>\u003Ctd>Low\u003C/td>\u003Ctd>Higher\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Result\u003C/td>\u003Ctd>Three equal new nodes\u003C/td>\u003Ctd>One old node, two new nodes\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Best for\u003C/td>\u003Ctd>Small and medium databases\u003C/td>\u003Ctd>Databases too large to copy\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Ch3 id=\"171-path-1-build-new-then-copy\">\u003Ca class=\"anchor\" href=\"#171-path-1-build-new-then-copy\" aria-hidden=\"true\">#\u003C/a>17.1 Path 1: build new, then copy\u003C/h3>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> up\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> db\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> import\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> shop_api\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> \\\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  --from\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> 'postgresql://user:password@old-server:5432/shop'\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>What \u003Ccode>db import\u003C/code> does:\u003C/p>\n\u003Col>\n\u003Cli>Creates the database and login, the same as \u003Ccode>db create\u003C/code>.\u003C/li>\n\u003Cli>Checks that the target database is empty. If not, it stops.\u003C/li>\n\u003Cli>Runs \u003Ccode>pg_dump\u003C/code> on the leader node against the old server.\u003C/li>\n\u003Cli>Sends the dump to \u003Ccode>pg_restore\u003C/code>. The project login owns all objects.\u003C/li>\n\u003Cli>Prints the number of tables.\u003C/li>\n\u003C/ol>\n\u003Cp>Rules:\u003C/p>\n\u003Cul>\n\u003Cli>The leader node must reach the old server on its Postgres port.\u003C/li>\n\u003Cli>The \u003Ccode>pg_dump\u003C/code> version on the node must be the same as or later than the\nold server version.\u003C/li>\n\u003Cli>Writes to the old database during the copy are not included. Stop the\napplication first.\u003C/li>\n\u003Cli>Only &quot;trusted&quot; extensions are created automatically (for example\n\u003Ccode>pgcrypto\u003C/code>, \u003Ccode>citext\u003C/code>, \u003Ccode>uuid-ossp\u003C/code>). For others, install the package on all\nnodes and create the extension as a superuser first.\u003C/li>\n\u003Cli>Use \u003Ccode>PGHA_SOURCE_URL\u003C/code> to keep the password out of your shell history.\u003C/li>\n\u003C/ul>\n\u003Ch3 id=\"172-path-2-adopt-the-server-in-place\">\u003Ca class=\"anchor\" href=\"#172-path-2-adopt-the-server-in-place\" aria-hidden=\"true\">#\u003C/a>17.2 Path 2: adopt the server in place\u003C/h3>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> adopt\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --server\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> my-old-db\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>Requirements:\u003C/p>\n\u003Cul>\n\u003Cli>A Hetzner Cloud server. Dedicated (Robot) servers are not supported.\u003C/li>\n\u003Cli>Ubuntu or Debian Postgres packages (the \u003Ccode>pg_lsclusters\u003C/code> layout).\u003C/li>\n\u003Cli>Exactly one online Postgres cluster, on port 5432, version 13 to 18.\u003C/li>\n\u003Cli>The server is a primary, not a replica.\u003C/li>\n\u003Cli>SSH access as \u003Ccode>root\u003C/code> on its public IPv4 address.\u003C/li>\n\u003Cli>New-node volumes larger than 1.3 times the data size.\u003C/li>\n\u003C/ul>\n\u003Cp>What \u003Ccode>adopt\u003C/code> does:\u003C/p>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Step\u003C/th>\u003Cth>Where\u003C/th>\u003Cth>Action\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>1\u003C/td>\u003Ctd>Old server\u003C/td>\u003Ctd>Read-only check. The tool prints the plan and the bill.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>2\u003C/td>\u003Ctd>Hetzner\u003C/td>\u003Ctd>Creates the network, firewall, load balancer and two new nodes. \u003Ccode>--network\u003C/code> uses that network instead of creating one.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>3\u003C/td>\u003Ctd>Hetzner\u003C/td>\u003Ctd>Attaches the old server. The default address is \u003Ccode>10.0.1.11\u003C/code>. An existing attachment is kept.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>4\u003C/td>\u003Ctd>New nodes\u003C/td>\u003Ctd>Install software and start etcd. Patroni stays off.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>5\u003C/td>\u003Ctd>Old server\u003C/td>\u003Ctd>Installs Patroni and etcd. Joins etcd.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>6\u003C/td>\u003Ctd>Old server\u003C/td>\u003Ctd>Creates the roles \u003Ccode>pgha_admin\u003C/code> and \u003Ccode>replicator\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>7\u003C/td>\u003Ctd>Old server\u003C/td>\u003Ctd>Adds access rules at the top of \u003Ccode>pg_hba.conf\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>8\u003C/td>\u003Ctd>Old server\u003C/td>\u003Ctd>Stores the live settings as the cluster settings.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>9\u003C/td>\u003Ctd>Old server\u003C/td>\u003Ctd>Starts Patroni. It attaches to the running Postgres.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>10\u003C/td>\u003Ctd>Old server\u003C/td>\u003Ctd>Restarts Postgres one time. \u003Cstrong>This is the downtime.\u003C/strong>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>11\u003C/td>\u003Ctd>New nodes\u003C/td>\u003Ctd>Start Patroni. They copy the data and become replicas.\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>Safety:\u003C/p>\n\u003Cul>\n\u003Cli>Steps 1 to 8 do not stop Postgres.\u003C/li>\n\u003Cli>If step 9 or 10 fails, the script puts back \u003Ccode>postgresql.conf\u003C/code>,\n\u003Ccode>pg_hba.conf\u003C/code> and \u003Ccode>start.conf\u003C/code>, and starts Postgres under the old service.\u003C/li>\n\u003Cli>The script keeps copies with the ending \u003Ccode>.pgha-backup\u003C/code>.\u003C/li>\n\u003Cli>The script does not change the password of the \u003Ccode>postgres\u003C/code> role.\u003C/li>\n\u003Cli>You can run \u003Ccode>adopt\u003C/code> again. It completes the missing parts.\u003C/li>\n\u003C/ul>\n\u003Cp>What you must know:\u003C/p>\n\u003Cul>\n\u003Cli>Applications must move to the load balancer address. A direct connection\nto the old server stops to work after a failover.\u003C/li>\n\u003Cli>The old server keeps its data on its current disk.\u003C/li>\n\u003Cli>The new firewall is not applied to the old server.\u003C/li>\n\u003Cli>These settings are copied to the cluster settings: \u003Ccode>max_connections\u003C/code>,\nworker and lock limits, \u003Ccode>shared_preload_libraries\u003C/code>, \u003Ccode>work_mem\u003C/code>,\n\u003Ccode>maintenance_work_mem\u003C/code>, \u003Ccode>random_page_cost\u003C/code>, \u003Ccode>effective_io_concurrency\u003C/code>,\nWAL size limits, time zone and date style. Other custom settings stay on\nthe old server only.\u003C/li>\n\u003Cli>New nodes need the same extension packages:\n\u003Ccode>--extra-packages postgresql-16-postgis-3\u003C/code>.\u003C/li>\n\u003Cli>Password rules in \u003Ccode>pg_hba.conf\u003C/code> on the new nodes use \u003Ccode>md5\u003C/code>. This method\naccepts both MD5 and SCRAM passwords.\u003C/li>\n\u003Cli>\u003Ccode>adopt\u003C/code> does not set up backups or PgBouncer.\u003C/li>\n\u003Cli>\u003Ccode>down\u003C/code> is blocked.\u003C/li>\n\u003C/ul>\n\u003Cp>To leave the cluster by hand, on the old server:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">systemctl\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> disable\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --now\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> patroni\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">cd\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> /etc/postgresql/\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">&#x3C;\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">versio\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">n\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">>\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">/main\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">cp\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -p\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> postgresql.conf.pgha-backup\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> postgresql.conf\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">rm\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -f\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> postgresql.base.conf\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">cp\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> -p\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> start.conf.pgha-backup\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> start.conf\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">systemctl\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> restart\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> postgresql@\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">&#x3C;\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">versio\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">n\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">>\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">-main\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>Then delete the new nodes, load balancer and network in the Hetzner console.\u003C/p>\n",[7,10],{"id":8,"text":9},"171-path-1-build-new-then-copy","17.1 Path 1: build new, then copy",{"id":11,"text":12},"172-path-2-adopt-the-server-in-place","17.2 Path 2: adopt the server in place","There are two paths. Path 1 is safer.",{"slug":15,"title":16},"alerts","Alerts",{"slug":18,"title":19},"operations","Operations"],"uses":{"params":["slug"]}}]}
