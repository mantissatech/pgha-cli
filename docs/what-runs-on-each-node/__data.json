{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,6,10,14,18,22,26,30,34,38,42,46,50,54,58,62,66,70,74,78,82,86,90,94,98],{"slug":3,"title":4,"num":5},"what-pgha-does","What pgha does",1,{"slug":7,"title":8,"num":9},"architecture","Architecture",2,{"slug":11,"title":12,"num":13},"requirements","Requirements",3,{"slug":15,"title":16,"num":17},"install","Install",4,{"slug":19,"title":20,"num":21},"quick-start","Quick start",5,{"slug":23,"title":24,"num":25},"command-reference","Command reference",6,{"slug":27,"title":28,"num":29},"environment-variables","Environment variables",7,{"slug":31,"title":32,"num":33},"the-state-file","The state file",8,{"slug":35,"title":36,"num":37},"cloud-resources","Cloud resources",9,{"slug":39,"title":40,"num":41},"what-runs-on-each-node","What runs on each node",10,{"slug":43,"title":44,"num":45},"the-monthly-bill","The monthly bill",11,{"slug":47,"title":48,"num":49},"project-databases","Project databases",12,{"slug":51,"title":52,"num":53},"pgbouncer-and-connection-limits","PgBouncer and connection limits",13,{"slug":55,"title":56,"num":57},"backups","Backups",14,{"slug":59,"title":60,"num":61},"tailscale","Tailscale",15,{"slug":63,"title":64,"num":65},"alerts","Alerts",16,{"slug":67,"title":68,"num":69},"move-from-an-existing-server","Move from an existing server",17,{"slug":71,"title":72,"num":73},"operations","Operations",18,{"slug":75,"title":76,"num":77},"troubleshooting","Troubleshooting",19,{"slug":79,"title":80,"num":81},"security","Security",20,{"slug":83,"title":84,"num":85},"limits","Limits",21,{"slug":87,"title":88,"num":89},"test-status","Test status",22,{"slug":91,"title":92,"num":93},"code-structure","Code structure",23,{"slug":95,"title":96,"num":97},"development","Development",24,{"slug":99,"title":100,"num":101},"references","References",null],"uses":{}},{"type":"data","data":[{"doc":1,"prev":17,"next":20},{"slug":2,"num":3,"title":4,"html":5,"toc":6,"summary":16},"what-runs-on-each-node",10,"What runs on each node","\u003Cp>Cloud-init runs the script \u003Ccode>/usr/local/sbin/pgha-bootstrap\u003C/code> one time, at the\nfirst start. The log is \u003Ccode>/var/log/pgha-bootstrap.log\u003C/code>.\u003C/p>\n\u003Cp>The script does these steps:\u003C/p>\n\u003Col>\n\u003Cli>Waits for the data volume and mounts it at \u003Ccode>/mnt/pgdata\u003C/code>.\u003C/li>\n\u003Cli>Waits for the private address.\u003C/li>\n\u003Cli>Joins Tailscale, if \u003Ccode>--tailscale\u003C/code> is on.\u003C/li>\n\u003Cli>Adds the PostgreSQL package source (PGDG).\u003C/li>\n\u003Cli>Installs PostgreSQL, Patroni, etcd and the optional tools.\u003C/li>\n\u003Cli>Writes the configuration files.\u003C/li>\n\u003Cli>Starts etcd and Patroni.\u003C/li>\n\u003Cli>Enables \u003Ccode>pgha-monitor.timer\u003C/code>, if \u003Ccode>--monitor\u003C/code> is on.\u003C/li>\n\u003Cli>Creates \u003Ccode>/var/lib/pgha-bootstrap.done\u003C/code>.\u003C/li>\n\u003C/ol>\n\u003Ch3 id=\"files-and-paths\">\u003Ca class=\"anchor\" href=\"#files-and-paths\" aria-hidden=\"true\">#\u003C/a>Files and paths\u003C/h3>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Path\u003C/th>\u003Cth>Content\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode>/mnt/pgdata/&lt;version&gt;/main\u003C/code>\u003C/td>\u003Ctd>Postgres data folder, on the volume.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>/etc/patroni/config.yml\u003C/code>\u003C/td>\u003Ctd>Patroni configuration.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>/etc/default/etcd\u003C/code>\u003C/td>\u003Ctd>etcd configuration.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>/var/lib/etcd/pgha\u003C/code>\u003C/td>\u003Ctd>etcd data.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>/etc/pgbackrest/pgbackrest.conf\u003C/code>\u003C/td>\u003Ctd>pgBackRest configuration (backups on).\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>/usr/local/sbin/pgha-backup\u003C/code>\u003C/td>\u003Ctd>Backup script (backups on).\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>/usr/local/sbin/pgha-monitor\u003C/code>\u003C/td>\u003Ctd>Alert script (alerts on). Mode \u003Ccode>0700\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>/etc/pgha/monitor.env\u003C/code>\u003C/td>\u003Ctd>Alert thresholds and peer list. No webhook URL. Mode \u003Ccode>0600\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>/etc/pgha/webhook.curl\u003C/code>\u003C/td>\u003Ctd>Webhook URL for curl. Mode \u003Ccode>0600\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>/var/lib/pgha/monitor.state\u003C/code>\u003C/td>\u003Ctd>Open alerts. Install never deletes this file.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>/etc/pgbouncer/pgbouncer.ini\u003C/code>\u003C/td>\u003Ctd>PgBouncer configuration (PgBouncer on).\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>/etc/pgbouncer/pgha-databases.ini\u003C/code>\u003C/td>\u003Ctd>Connection limits for each database.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>/var/log/pgha-bootstrap.log\u003C/code>\u003C/td>\u003Ctd>Install log.\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Ch3 id=\"services\">\u003Ca class=\"anchor\" href=\"#services\" aria-hidden=\"true\">#\u003C/a>Services\u003C/h3>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>systemd unit\u003C/th>\u003Cth>When\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode>etcd\u003C/code>\u003C/td>\u003Ctd>Always\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>patroni\u003C/code>\u003C/td>\u003Ctd>Always. Patroni starts and stops Postgres.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>pgbouncer\u003C/code>\u003C/td>\u003Ctd>With \u003Ccode>--pgbouncer\u003C/code>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>pgha-backup.timer\u003C/code>\u003C/td>\u003Ctd>With backups\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>pgha-monitor.timer\u003C/code>\u003C/td>\u003Ctd>With \u003Ccode>--monitor\u003C/code> or \u003Ccode>pgha monitor install\u003C/code>\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>Do not start or stop Postgres with \u003Ccode>systemctl\u003C/code> or \u003Ccode>pg_ctl\u003C/code>. Use \u003Ccode>patronictl\u003C/code>.\u003C/p>\n\u003Ch3 id=\"main-settings\">\u003Ca class=\"anchor\" href=\"#main-settings\" aria-hidden=\"true\">#\u003C/a>Main settings\u003C/h3>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Setting\u003C/th>\u003Cth>Value\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode>max_connections\u003C/code>\u003C/td>\u003Ctd>200\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>shared_buffers\u003C/code>\u003C/td>\u003Ctd>25% of server memory\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>effective_cache_size\u003C/code>\u003C/td>\u003Ctd>50% of server memory\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Replication\u003C/td>\u003Ctd>Asynchronous, with replication slots\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Data checksums\u003C/td>\u003Ctd>On\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Password method\u003C/td>\u003Ctd>\u003Ccode>scram-sha-256\u003C/code>\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Patroni \u003Ccode>ttl\u003C/code> / \u003Ccode>loop_wait\u003C/code> / \u003Ccode>retry_timeout\u003C/code>\u003C/td>\u003Ctd>30 / 10 / 10 seconds\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>maximum_lag_on_failover\u003C/code>\u003C/td>\u003Ctd>1 MB\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>use_pg_rewind\u003C/code>\u003C/td>\u003Ctd>On\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>To change a cluster setting, use \u003Ccode>patronictl edit-config\u003C/code> on a node.\u003C/p>\n",[7,10,13],{"id":8,"text":9},"files-and-paths","Files and paths",{"id":11,"text":12},"services","Services",{"id":14,"text":15},"main-settings","Main settings","Cloud-init runs the script /usr/local/sbin/pgha-bootstrap one time, at the first start. The log is /var/log/pgha-bootstrap.log.",{"slug":18,"title":19},"cloud-resources","Cloud resources",{"slug":21,"title":22},"the-monthly-bill","The monthly bill"],"uses":{"params":["slug"]}}]}
