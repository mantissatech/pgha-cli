{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,6,10,14,18,22,26,30,34,38,42,46,50,54,58,62,66,70,74,78,82,86,90,94,98],{"slug":3,"title":4,"num":5},"what-pgha-does","What pgha does",1,{"slug":7,"title":8,"num":9},"architecture","Architecture",2,{"slug":11,"title":12,"num":13},"requirements","Requirements",3,{"slug":15,"title":16,"num":17},"install","Install",4,{"slug":19,"title":20,"num":21},"quick-start","Quick start",5,{"slug":23,"title":24,"num":25},"command-reference","Command reference",6,{"slug":27,"title":28,"num":29},"environment-variables","Environment variables",7,{"slug":31,"title":32,"num":33},"the-state-file","The state file",8,{"slug":35,"title":36,"num":37},"cloud-resources","Cloud resources",9,{"slug":39,"title":40,"num":41},"what-runs-on-each-node","What runs on each node",10,{"slug":43,"title":44,"num":45},"the-monthly-bill","The monthly bill",11,{"slug":47,"title":48,"num":49},"project-databases","Project databases",12,{"slug":51,"title":52,"num":53},"pgbouncer-and-connection-limits","PgBouncer and connection limits",13,{"slug":55,"title":56,"num":57},"backups","Backups",14,{"slug":59,"title":60,"num":61},"tailscale","Tailscale",15,{"slug":63,"title":64,"num":65},"alerts","Alerts",16,{"slug":67,"title":68,"num":69},"move-from-an-existing-server","Move from an existing server",17,{"slug":71,"title":72,"num":73},"operations","Operations",18,{"slug":75,"title":76,"num":77},"troubleshooting","Troubleshooting",19,{"slug":79,"title":80,"num":81},"security","Security",20,{"slug":83,"title":84,"num":85},"limits","Limits",21,{"slug":87,"title":88,"num":89},"test-status","Test status",22,{"slug":91,"title":92,"num":93},"code-structure","Code structure",23,{"slug":95,"title":96,"num":97},"development","Development",24,{"slug":99,"title":100,"num":101},"references","References",null],"uses":{}},{"type":"data","data":[{"doc":1,"prev":20,"next":23},{"slug":2,"num":3,"title":4,"html":5,"toc":6,"summary":19},"alerts",16,"Alerts","\u003Cp>Each node can run a check once a minute and post one JSON webhook per\ncondition. The timer stays off until you ask for it. Your computer does\nnot need to stay on.\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">export\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> PGHA_ALERT_WEBHOOK\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">https://example.test/hook\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> up\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --monitor\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>On a cluster that already exists:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">export\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> PGHA_ALERT_WEBHOOK\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">https://example.test/hook\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> monitor\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> install\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>\u003Ccode>adopt --monitor\u003C/code> installs the timer on the new nodes and on the existing\nserver.\u003C/p>\n\u003Cp>\u003Ccode>up\u003C/code> does not change a node that already exists. If \u003Ccode>--monitor\u003C/code> is set and\nany node already existed, \u003Ccode>up\u003C/code> still succeeds and prints:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"text\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan>monitor installs on new nodes; run pgha monitor install\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>Run \u003Ccode>pgha monitor install\u003C/code> to put the same files on those nodes.\u003C/p>\n\u003Ch3 id=\"flags\">\u003Ca class=\"anchor\" href=\"#flags\" aria-hidden=\"true\">#\u003C/a>Flags\u003C/h3>\n\u003Cp>\u003Ccode>up\u003C/code>, \u003Ccode>adopt\u003C/code>, and \u003Ccode>monitor install\u003C/code> accept these flags. \u003Ccode>estimate\u003C/code> does\nnot. \u003Ccode>--monitor\u003C/code> is only on \u003Ccode>up\u003C/code> and \u003Ccode>adopt\u003C/code>.\u003C/p>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Flag\u003C/th>\u003Cth>Default\u003C/th>\u003Cth>Meaning\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode>--monitor\u003C/code>\u003C/td>\u003Ctd>off\u003C/td>\u003Ctd>Install the timer on nodes created in this run.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>--lag-mb\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>100\u003C/code>\u003C/td>\u003Ctd>Alert when replica lag is above this many MB (1 to 100000).\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>--disk-free-pct\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>10\u003C/code>\u003C/td>\u003Ctd>Alert when free space is below this percent (1 to 50).\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>--repeat-min\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>30\u003C/code>\u003C/td>\u003Ctd>Minutes between repeat alerts (1 to 1440).\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>--backup-every-min\u003C/code>\u003C/td>\u003Ctd>\u003Ccode>15\u003C/code>\u003C/td>\u003Ctd>Minutes between backup checks (1 to 1440).\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>A flag you type replaces the stored value. A flag you leave out keeps the\nstored value. The first save stores the default for each flag you leave out.\u003C/p>\n\u003Cp>The webhook comes only from \u003Ccode>PGHA_ALERT_WEBHOOK\u003C/code>. It must be \u003Ccode>https\u003C/code> and it\nmust have a host. A path and a query are allowed. \u003Ccode>http\u003C/code> is refused. The\ntool reads the variable only when \u003Ccode>--monitor\u003C/code> is set, or when \u003Ccode>monitor install\u003C/code> runs. \u003Ccode>monitor install\u003C/code> reuses the saved URL when the variable is\nempty.\u003C/p>\n\u003Ch3 id=\"checks\">\u003Ca class=\"anchor\" href=\"#checks\" aria-hidden=\"true\">#\u003C/a>Checks\u003C/h3>\n\u003Cp>The timer is \u003Ccode>pgha-monitor.timer\u003C/code>. It starts about one minute after boot,\nthen every minute, with up to 15 seconds of delay. The script is\n\u003Ccode>/usr/local/sbin/pgha-monitor\u003C/code>.\u003C/p>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Check\u003C/th>\u003Cth>Who sends\u003C/th>\u003Cth>When it fires\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>\u003Ccode>disk\u003C/code>\u003C/td>\u003Ctd>Each node\u003C/td>\u003Ctd>Free space on the filesystem of the Patroni data directory is under \u003Ccode>--disk-free-pct\u003C/code>. New nodes use \u003Ccode>/mnt/pgdata\u003C/code>. An adopted server uses its existing data directory.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>lag\u003C/code>\u003C/td>\u003Ctd>A node that is not the leader\u003C/td>\u003Ctd>Replica lag is above \u003Ccode>--lag-mb\u003C/code>, or the lag value is missing.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>pool\u003C/code>\u003C/td>\u003Ctd>Each node, when PgBouncer is installed\u003C/td>\u003Ctd>\u003Ccode>cl_waiting\u003C/code> is above zero.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>patroni\u003C/code>\u003C/td>\u003Ctd>Each node\u003C/td>\u003Ctd>Local Patroni is down, or \u003Ccode>patronictl list\u003C/code> fails.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>backup\u003C/code>\u003C/td>\u003Ctd>The leader, when backups are on\u003C/td>\u003Ctd>\u003Ccode>pgbackrest check\u003C/code> fails. The check runs at most once per \u003Ccode>--backup-every-min\u003C/code>.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>primary\u003C/code>\u003C/td>\u003Ctd>One node\u003C/td>\u003Ctd>There is no healthy primary.\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>\u003Ccode>member:&lt;name&gt;\u003C/code>\u003C/td>\u003Ctd>The leader\u003C/td>\u003Ctd>That member is missing or not healthy.\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>Most checks need two bad runs in a row before the first alert. The backup\ncheck alerts on the first failure. A later healthy run sends \u003Ccode>resolved\u003C/code>.\nWhile a condition stays bad, the alert repeats after \u003Ccode>--repeat-min\u003C/code> minutes.\u003C/p>\n\u003Cp>One node sends the \u003Ccode>primary\u003C/code>, \u003Ccode>backup\u003C/code>, and \u003Ccode>member\u003C/code> alerts. Each node\nsends its own \u003Ccode>disk\u003C/code>, \u003Ccode>lag\u003C/code>, \u003Ccode>pool\u003C/code>, and \u003Ccode>patroni\u003C/code> alerts. If etcd is down,\neach live node may send its own \u003Ccode>patroni\u003C/code> alert.\u003C/p>\n\u003Cp>A check that does not apply logs nothing. Every check that ran writes one\njournal line: \u003Ccode>pgha-monitor &lt;check&gt; ok\u003C/code>, \u003Ccode>pending\u003C/code>, \u003Ccode>firing\u003C/code>, or \u003Ccode>resolved\u003C/code>.\u003C/p>\n\u003Ch3 id=\"webhook-body\">\u003Ca class=\"anchor\" href=\"#webhook-body\" aria-hidden=\"true\">#\u003C/a>Webhook body\u003C/h3>\n\u003Cdiv class=\"code-block\" data-lang=\"json\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">{\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  \"cluster\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">: \u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"pgha\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  \"node\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">: \u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"pgha-pg2\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  \"check\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">: \u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"disk\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  \"status\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">: \u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"firing\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  \"summary\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">: \u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"8% free on /mnt/pgdata\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">,\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\">  \"since\"\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">: \u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\">\"2026-10-05T12:00:00Z\"\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">}\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>\u003Ccode>node\u003C/code> is the node that sent the alert. \u003Ccode>status\u003C/code> is \u003Ccode>firing\u003C/code> or \u003Ccode>resolved\u003C/code>.\nA resolved alert uses the summary \u003Ccode>recovered\u003C/code>. \u003Ccode>since\u003C/code> is the UTC time of\nthe first bad run. \u003Ccode>check\u003C/code> is \u003Ccode>disk\u003C/code>, \u003Ccode>lag\u003C/code>, \u003Ccode>pool\u003C/code>, \u003Ccode>patroni\u003C/code>, \u003Ccode>backup\u003C/code>,\n\u003Ccode>primary\u003C/code>, or \u003Ccode>member:&lt;name&gt;\u003C/code>.\u003C/p>\n\u003Cp>Other summaries include \u003Ccode>lag 240 MB\u003C/code>, \u003Ccode>no primary\u003C/code>, \u003Ccode>pgha-pg3 missing\u003C/code>,\n\u003Ccode>data directory missing\u003C/code>, and \u003Ccode>pgbouncer unreachable\u003C/code>.\u003C/p>\n\u003Cp>A failed POST is logged as \u003Ccode>pgha-monitor webhook failed\u003C/code> and retried on the\nnext run. The timer still exits 0.\u003C/p>\n\u003Ch3 id=\"stop-and-update\">\u003Ca class=\"anchor\" href=\"#stop-and-update\" aria-hidden=\"true\">#\u003C/a>Stop and update\u003C/h3>\n\u003Cp>There is no disable command. On a node:\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">systemctl\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> disable\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --now\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> pgha-monitor.timer\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>\u003Ccode>pgha monitor install\u003C/code> enables the timer again and is how you change the\nwebhook or the thresholds later. \u003Ccode>down\u003C/code> deletes the servers. The webhook\nstays in the state file.\u003C/p>\n\u003Cp>\u003Ccode>monitor install\u003C/code> tries every node that has an SSH host. If one node fails,\nthe others still receive the files. The command then prints one line per\nfailed node: \u003Ccode>install failed on &lt;name&gt;\u003C/code>. Run it again. It does not delete\nopen alerts.\u003C/p>\n\u003Cp>Cloud-init user data must stay at or under 32 KiB. A node with backups,\nPgBouncer, Tailscale, and the monitor still fits under that limit.\u003C/p>\n",[7,10,13,16],{"id":8,"text":9},"flags","Flags",{"id":11,"text":12},"checks","Checks",{"id":14,"text":15},"webhook-body","Webhook body",{"id":17,"text":18},"stop-and-update","Stop and update","Each node can run a check once a minute and post one JSON webhook per condition. The timer stays off until you ask for it. Your computer does not need to sta…",{"slug":21,"title":22},"tailscale","Tailscale",{"slug":24,"title":25},"move-from-an-existing-server","Move from an existing server"],"uses":{"params":["slug"]}}]}
