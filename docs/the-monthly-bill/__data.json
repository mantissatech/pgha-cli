{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,6,10,14,18,22,26,30,34,38,42,46,50,54,58,62,66,70,74,78,82,86,90,94,98,102,106],{"slug":3,"title":4,"num":5},"what-pgha-does","What pgha does",1,{"slug":7,"title":8,"num":9},"architecture","Architecture",2,{"slug":11,"title":12,"num":13},"requirements","Requirements",3,{"slug":15,"title":16,"num":17},"install","Install",4,{"slug":19,"title":20,"num":21},"container-image","Container image",5,{"slug":23,"title":24,"num":25},"run-the-console-on-a-server","Run the console on a server",6,{"slug":27,"title":28,"num":29},"quick-start","Quick start",7,{"slug":31,"title":32,"num":33},"command-reference","Command reference",8,{"slug":35,"title":36,"num":37},"environment-variables","Environment variables",9,{"slug":39,"title":40,"num":41},"the-state-file","The state file",10,{"slug":43,"title":44,"num":45},"cloud-resources","Cloud resources",11,{"slug":47,"title":48,"num":49},"what-runs-on-each-node","What runs on each node",12,{"slug":51,"title":52,"num":53},"the-monthly-bill","The monthly bill",13,{"slug":55,"title":56,"num":57},"project-databases","Project databases",14,{"slug":59,"title":60,"num":61},"pgbouncer-and-connection-limits","PgBouncer and connection limits",15,{"slug":63,"title":64,"num":65},"backups","Backups",16,{"slug":67,"title":68,"num":69},"tailscale","Tailscale",17,{"slug":71,"title":72,"num":73},"alerts","Alerts",18,{"slug":75,"title":76,"num":77},"move-from-an-existing-server","Move from an existing server",19,{"slug":79,"title":80,"num":81},"operations","Operations",20,{"slug":83,"title":84,"num":85},"troubleshooting","Troubleshooting",21,{"slug":87,"title":88,"num":89},"security","Security",22,{"slug":91,"title":92,"num":93},"limits","Limits",23,{"slug":95,"title":96,"num":97},"test-status","Test status",24,{"slug":99,"title":100,"num":101},"code-structure","Code structure",25,{"slug":103,"title":104,"num":105},"development","Development",26,{"slug":107,"title":108,"num":109},"references","References",null],"uses":{}},{"type":"data","data":[{"doc":1,"prev":11,"next":14},{"slug":2,"num":3,"title":4,"html":5,"toc":6,"summary":10},"the-monthly-bill",13,"The monthly bill","\u003Cp>\u003Ccode>estimate\u003C/code>, \u003Ccode>up\u003C/code> and \u003Ccode>adopt\u003C/code> show the bill before they create resources.\u003C/p>\n\u003Cdiv class=\"table-wrap\">\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>Line\u003C/th>\u003Cth>Source of the price\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>Servers\u003C/td>\u003Ctd>Hetzner pricing API, for each location\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Primary IPv4 addresses\u003C/td>\u003Ctd>Hetzner pricing API\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Volumes\u003C/td>\u003Ctd>Hetzner pricing API, price for each GB\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Load balancer\u003C/td>\u003Ctd>Hetzner pricing API\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>Backup storage, max\u003C/td>\u003Ctd>List prices from flags (see below)\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>The bill shows the net total and the total with the VAT rate of your account.\u003C/p>\n\u003Cp>Notes:\u003C/p>\n\u003Cul>\n\u003Cli>Hetzner bills by the hour up to the monthly price.\u003C/li>\n\u003Cli>Traffic above the included amount is not in the bill.\u003C/li>\n\u003Cli>If a server type is not available in a location, the bill shows a warning.\u003C/li>\n\u003Cli>For \u003Ccode>adopt\u003C/code>, the bill counts only the new nodes.\u003C/li>\n\u003C/ul>\n\u003Ch3 id=\"the-backup-storage-line\">\u003Ca class=\"anchor\" href=\"#the-backup-storage-line\" aria-hidden=\"true\">#\u003C/a>The backup storage line\u003C/h3>\n\u003Cp>The Hetzner API has no object storage prices. This line uses the values of\n\u003Ccode>--s3-base-price\u003C/code>, \u003Ccode>--s3-price-per-tb\u003C/code> and \u003Ccode>--s3-included-gb\u003C/code>.\u003C/p>\n\u003Cdiv class=\"code-block\" data-lang=\"text\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan>max GB   = (backup-keep-full + 1) x volume-gb\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan>cost     = base price + (max GB - included GB) / 1000 x price per TB\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>One extra full backup exists for a short time before the oldest backup\nexpires. The maximum assumes a full disk and no compression. WAL files,\ndifferential backups and egress traffic are not included.\u003C/p>\n\u003Cp>Check the default prices in your Hetzner console before you rely on them.\u003C/p>\n",[7],{"id":8,"text":9},"the-backup-storage-line","The backup storage line","The bill shows the net total and the total with the VAT rate of your account.",{"slug":12,"title":13},"what-runs-on-each-node","What runs on each node",{"slug":15,"title":16},"project-databases","Project databases"],"uses":{"params":["slug"]}}]}
