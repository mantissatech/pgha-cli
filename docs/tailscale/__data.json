{"type":"data","nodes":[null,{"type":"data","data":[{"nav":1},[2,6,10,14,18,22,26,30,34,38,42,46,50,54,58,62,66,70,74,78,82,86,90,94,98],{"slug":3,"title":4,"num":5},"what-pgha-does","What pgha does",1,{"slug":7,"title":8,"num":9},"architecture","Architecture",2,{"slug":11,"title":12,"num":13},"requirements","Requirements",3,{"slug":15,"title":16,"num":17},"install","Install",4,{"slug":19,"title":20,"num":21},"quick-start","Quick start",5,{"slug":23,"title":24,"num":25},"command-reference","Command reference",6,{"slug":27,"title":28,"num":29},"environment-variables","Environment variables",7,{"slug":31,"title":32,"num":33},"the-state-file","The state file",8,{"slug":35,"title":36,"num":37},"cloud-resources","Cloud resources",9,{"slug":39,"title":40,"num":41},"what-runs-on-each-node","What runs on each node",10,{"slug":43,"title":44,"num":45},"the-monthly-bill","The monthly bill",11,{"slug":47,"title":48,"num":49},"project-databases","Project databases",12,{"slug":51,"title":52,"num":53},"pgbouncer-and-connection-limits","PgBouncer and connection limits",13,{"slug":55,"title":56,"num":57},"backups","Backups",14,{"slug":59,"title":60,"num":61},"tailscale","Tailscale",15,{"slug":63,"title":64,"num":65},"alerts","Alerts",16,{"slug":67,"title":68,"num":69},"move-from-an-existing-server","Move from an existing server",17,{"slug":71,"title":72,"num":73},"operations","Operations",18,{"slug":75,"title":76,"num":77},"troubleshooting","Troubleshooting",19,{"slug":79,"title":80,"num":81},"security","Security",20,{"slug":83,"title":84,"num":85},"limits","Limits",21,{"slug":87,"title":88,"num":89},"test-status","Test status",22,{"slug":91,"title":92,"num":93},"code-structure","Code structure",23,{"slug":95,"title":96,"num":97},"development","Development",24,{"slug":99,"title":100,"num":101},"references","References",null],"uses":{}},{"type":"data","data":[{"doc":1,"prev":8,"next":11},{"slug":2,"num":3,"title":4,"html":5,"toc":6,"summary":7},"tailscale",15,"Tailscale","\u003Cdiv class=\"code-block\" data-lang=\"bash\">\u003Cpre class=\"shiki shiki-themes github-light github-dark\" style=\"--shiki-light:#24292e;--shiki-dark:#e1e4e8;--shiki-light-bg:#fff;--shiki-dark-bg:#24292e\" tabindex=\"0\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">export\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\"> TS_AUTHKEY\u003C/span>\u003Cspan style=\"--shiki-light:#D73A49;--shiki-dark:#F97583\">=\u003C/span>\u003Cspan style=\"--shiki-light:#24292E;--shiki-dark:#E1E4E8\">tskey-auth-...\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">./pgha\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> up\u003C/span>\u003Cspan style=\"--shiki-light:#005CC5;--shiki-dark:#79B8FF\"> --tailscale\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"--shiki-light:#6F42C1;--shiki-dark:#B392F0\">ssh\u003C/span>\u003Cspan style=\"--shiki-light:#032F62;--shiki-dark:#9ECBFF\"> root@prod-pg1\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\u003C/div>\n\u003Cp>With \u003Ccode>--tailscale\u003C/code>:\u003C/p>\n\u003Cul>\n\u003Cli>Each node installs Tailscale and joins your tailnet with its node name.\u003C/li>\n\u003Cli>The firewall has no public SSH rule.\u003C/li>\n\u003Cli>The \u003Ccode>backup\u003C/code>, \u003Ccode>db\u003C/code>, and \u003Ccode>monitor install\u003C/code> commands reach the nodes by\ntheir MagicDNS names. Your computer must be on the tailnet.\u003C/li>\n\u003C/ul>\n\u003Cp>Auth key rules:\u003C/p>\n\u003Cul>\n\u003Cli>The key must be \u003Cstrong>reusable\u003C/strong>. Three nodes use it.\u003C/li>\n\u003Cli>Use a \u003Cstrong>tagged\u003C/strong> key. Devices with a tag have no key expiry.\u003C/li>\n\u003Cli>The key is stored in the state file.\u003C/li>\n\u003C/ul>\n\u003Cp>If the join fails, a node has no SSH path. Use the Hetzner web console to\nget access, then read \u003Ccode>/var/log/pgha-bootstrap.log\u003C/code>.\u003C/p>\n\u003Cp>\u003Ccode>down\u003C/code> does not remove the devices from the Tailscale admin console. Remove\nthem there.\u003C/p>\n",[],"With --tailscale:",{"slug":9,"title":10},"backups","Backups",{"slug":12,"title":13},"alerts","Alerts"],"uses":{"params":["slug"]}}]}
